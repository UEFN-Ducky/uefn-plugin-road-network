{
  "id": "road-network",
  "kind": "plugin",
  "version": "1.35.1",
  "label": "City Builder",
  "description": "Build whole cities for UEFN: generate worlds with several cities, terrain and roads, lay out every building, street light, sign and tree as PCG layers with a live 3D preview, pick our own kit or Fortnite pieces, and build it in UEFN in one click, together with your team.",
  "min_app_version": "1.0.0",
  "default_enabled": false,
  "data_sharing": true,
  "secret_keys": [],
  "contributes": {
    "agent.tools": {
      "category": "road-network",
      "intent_pattern": "\\b(city builder|road network|city roads?|road splines?|interchange|road pieces?|build (a )?city)\\b",
      "plan_tools": [
        "road_network_list",
        "road_network_stats"
      ],
      "destructive_tools": [
        "road_network_delete",
        "road_network_city_delete",
        "road_network_project_delete",
        "road_network_reimport",
        "road_network_import_all",
        "road_network_pcg_place",
        "road_network_pcg_layer_delete",
        "road_network_pull"
      ]
    },
    "ui.panels": [
      {
        "id": "main",
        "title": "City Builder",
        "icon": "route",
        "entry": "ui/index.html"
      }
    ],
    "header.buttons": [
      {
        "id": "main",
        "title": "City Builder",
        "icon": "route",
        "action": "panel:main",
        "order": 60
      }
    ],
    "automations": {
      "nodes": [
        {
          "id": "road-network.stats",
          "label": "Road network pieces",
          "group": "Road Network",
          "config_fields": [
            {
              "id": "net_id",
              "label": "Network",
              "type": "string"
            }
          ],
          "outputs": [
            {
              "id": "stats",
              "label": "Pieces used",
              "type": "json"
            }
          ]
        },
        {
          "id": "road-network.pull",
          "label": "Pull roads from UEFN",
          "group": "Road Network",
          "config_fields": [
            {
              "id": "name",
              "label": "Network name",
              "type": "string"
            },
            {
              "id": "project",
              "label": "Project",
              "type": "string"
            },
            {
              "id": "actors",
              "label": "Road actors (comma list, empty = all)",
              "type": "string"
            }
          ],
          "outputs": [
            {
              "id": "network",
              "label": "Network id",
              "type": "text"
            }
          ]
        },
        {
          "id": "road-network.reimport",
          "label": "Reimport roads into UEFN",
          "group": "Road Network",
          "config_fields": [
            {
              "id": "net_id",
              "label": "Network",
              "type": "string"
            },
            {
              "id": "actor",
              "label": "Road actor",
              "type": "string"
            },
            {
              "id": "confirm",
              "label": "Replace it in UEFN",
              "type": "boolean"
            }
          ]
        },
        {
          "id": "road-network.generate",
          "label": "Generate cities, roads and terrain",
          "group": "Road Network",
          "config_fields": [
            {
              "id": "name",
              "label": "World name",
              "type": "string"
            },
            {
              "id": "seed",
              "label": "Seed",
              "type": "number"
            },
            {
              "id": "cities",
              "label": "Cities (count or JSON list)",
              "type": "string"
            },
            {
              "id": "size_km",
              "label": "Map size (km)",
              "type": "number"
            },
            {
              "id": "relief_m",
              "label": "Hill height (m)",
              "type": "number"
            },
            {
              "id": "ground_from",
              "label": "Use the ground of network (empty = new terrain)",
              "type": "string"
            },
            {
              "id": "options",
              "label": "Terrain and road options (JSON)",
              "type": "string"
            }
          ],
          "outputs": [
            {
              "id": "network",
              "label": "Network id",
              "type": "text"
            },
            {
              "id": "heightmap",
              "label": "Heightmap PNG",
              "type": "text"
            }
          ]
        },
        {
          "id": "road-network.import_all",
          "label": "Import all roads into UEFN",
          "group": "Road Network",
          "config_fields": [
            {
              "id": "net_id",
              "label": "Network",
              "type": "string"
            },
            {
              "id": "confirm",
              "label": "Paste them into UEFN",
              "type": "boolean"
            }
          ]
        },
        {
          "id": "road-network.pcg_plan",
          "label": "PCG layer plan",
          "group": "Road Network",
          "config_fields": [
            {
              "id": "net_id",
              "label": "Network",
              "type": "string"
            },
            {
              "id": "road_tag",
              "label": "Road actor tag (empty = the world's own)",
              "type": "string"
            }
          ],
          "outputs": [
            {
              "id": "plan",
              "label": "PCG graph plan",
              "type": "json"
            }
          ]
        }
      ],
      "templates": [
        {
          "id": "road-network-pcg-layers",
          "label": "Place a world's PCG layers in UEFN",
          "category": "Road Network",
          "description": "Chat start \u2192 PCG layer plan \u2192 Agent builds it with PCGToolset \u2192 Finish.",
          "graph": {
            "nodes": [
              {
                "id": "s",
                "type": "start.chat",
                "x": 0,
                "y": 0,
                "config": {}
              },
              {
                "id": "n",
                "type": "road-network.pcg_plan",
                "x": 200,
                "y": 0,
                "config": {}
              },
              {
                "id": "a",
                "type": "pipeline.agent",
                "x": 400,
                "y": 0,
                "config": {}
              },
              {
                "id": "f",
                "type": "pipeline.finish",
                "x": 600,
                "y": 0,
                "config": {}
              }
            ],
            "edges": [
              {
                "source": "s",
                "target": "n",
                "kind": "main"
              },
              {
                "source": "n",
                "target": "a",
                "kind": "main"
              },
              {
                "source": "a",
                "target": "f",
                "kind": "main"
              }
